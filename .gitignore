# --- Node / Next ---
node_modules/
.next/
out/
dist/
build/
*.tsbuildinfo
.vercel

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- macOS ---
.DS_Store

# =====================================================================
# Kane CLI  —  these rules are deliberate, do not "tidy" them
# =====================================================================

# Kane variable files hold credentials. Never commit.
.testmuai/variables/

# The assurance store is single-writer and NOT git-mergeable: two branches
# appending records corrupts it on the next read. Share by re-ingesting
# sources instead. See docs/user-guide/assurance/overview.md upstream.
.context/

# Sealed evidence packs are large and regenerated per run, so they are
# ignored by default. We force-add a small number of curated packs for
# reviewers with `git add -f`, so a judge can open real evidence in the
# viewer without spending their own credits.
.testmuai/evidence/

# NOTE: `output-*/` and `helper-output-*/` are intentionally NOT ignored.
# They hold Kane's cached step recordings. Committing them is what lets
# anyone else replay this suite from cache — free, no LLM cost, no
# re-authoring. Ignoring them would silently break replay for reviewers.

# Scratch
.tmp/

# Editor state. Deleted once and recreated by the IDE holding `{}` — there is no
# setting in it to preserve, and a file that reappears empty after every session is
# noise in `git status` rather than configuration anyone shares.
.vscode/

# iCloud exclusion marker
.nosync

# =====================================================================
# KEPT working state  —  one committed file, everything else disposable
# =====================================================================

# `.kept/` is regenerable single-writer working state: state.json, plan.json,
# sources.json, handoff.json plus handoff/, review-cards/ and amendments/.
# Deleting it costs one `kept build`, and committing it would make two branches
# fight over the same non-mergeable files (design §13.2.2).
#
# Written as `.kept/*`, not `.kept/`, deliberately: git never descends into an
# excluded directory, so `.kept/` followed by a negation would silently ignore
# the negation. Excluding the *entries* keeps the one exception below working.
.kept/*

# config.json is committed configuration, not state. It carries the
# `verdictRouter` selection (design §6.4) — the single string the verdict spike
# can change, fenced by the router-isolation scan — plus memberDebug and the
# two timeouts. It has to be reviewable in history.
!.kept/config.json

# =====================================================================
# Force-added artefacts  —  what makes replay and evidence free for judges
# =====================================================================

# Kane recordings: committed so replay costs no authoring credits (R13.6).
# Nothing above ignores them; these negations state the intent explicitly so a
# later broad rule cannot swallow a recording without the diff showing it.
!output-*/
!helper-output-*/

# Curated evidence packs: `kept snapshot` copies the referenced packs here and
# rewrites their publicPath values (design §15.3). The Ledger links straight at
# these files with zero Kane invocations, so they are committed (R13.4, R13.5).
!apps/ledger/public/evidence/
!apps/ledger/data/ledger.snapshot.json

# Diagram rasters: regenerable with tools/build-diagrams.sh, and the SVGs are the
# tracked deliverable the README renders. Kept out of git as diagram rasters.
Assets/kept-architecture.png
Assets/kept-three-contracts.png
Assets/kept-verify-path.png
Assets/kept-repair-branches.png
Assets/kept-promise-lifecycle.png

# Anything iCloud is told to leave alone.
#
# iCloud Drive skips any item whose name ends in `.nosync`, and this repository lives under a
# synced Desktop. `node_modules` is roughly 437 MB across tens of thousands of small files, and
# handing that to iCloud starved the sync of the files that matter: source files came back flagged
# `dataless`, meaning the metadata was present and the bytes were not, so `tsc -b` blocked for
# minutes on a read that could fail outright with `ECANCELED`.
#
# So dependencies are installed into `node_modules.nosync` and reached through a `node_modules`
# symlink. Node resolves through the link and iCloud never sees the tree. Re-create both after any
# `npm ci`, which removes the link:
#
#   npm ci && rm -rf node_modules && mkdir -p node_modules.nosync && ln -s node_modules.nosync node_modules
#
# Prefer `npm install` over `npm ci` while the link is in place: `npm install` writes through it,
# and `npm ci` deletes it first.
*.nosync
*.nosync/

# The symlink itself, which the `node_modules/` rule above does not catch.
#
# A pattern ending in a slash matches directories only, and `node_modules` is a *symlink* here, which
# git sees as a file. So the link showed up as an untracked path and would have been committed by a
# `git add -A`, handing every clone a dangling pointer to a directory that does not exist for them.
# This rule names it without a slash, so it matches whichever of the two it happens to be.
/node_modules
